generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  PARTNER
  SUPER_ADMIN
  OPERATIONS
  CS
  FINANCE
  PARTNER_ADMIN
}
enum PartnerStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}
enum PartnerClaimStatus {
  UNCLAIMED
  CLAIMED
}
enum StorefrontStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}
enum PartnerMediaKind {
  LOGO
  PROFILE
  BANNER
  GALLERY
}
enum PartnerClaimInvitationStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}
enum OrderStatus {
  NEW
  SEARCHING_PARTNER
  OFFERED
  ACCEPTED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
  REFUND_PENDING
  REFUNDED
}
enum DispatchStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PayoutStatus {
  REQUESTED
  UNDER_REVIEW
  PROCESSING
  PAID
  REJECTED
  FAILED
}
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WAITING_CUSTOMER
  WAITING_PARTNER
  RESOLVED
  CLOSED
}
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum MessageRole {
  CUSTOMER
  PARTNER
  ADMIN
  SYSTEM
}
enum AttachmentKind {
  IMAGE
  DOCUMENT
}
enum LedgerDirection {
  DEBIT
  CREDIT
}
enum WalletBucket {
  PENDING
  AVAILABLE
  ON_HOLD
}

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique
  email        String?  @unique
  username     String?  @unique
  displayName  String?
  passwordHash String?
  role         UserRole @default(CUSTOMER)
  totpSecret   String?
  totpEnabled  Boolean  @default(false)
  active       Boolean  @default(true)
  lastLoginAt DateTime?
  passwordChangedAt DateTime?
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  sessionVersion Int @default(0)
  recoveryCodes RecoveryCode[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  customer     CustomerProfile?
  partner      Partner?
  auditLogs    AuditLog[] @relation("AuditActor")
}

model RecoveryCode {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, usedAt])
}

model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  addresses Address[]
  orders Order[]
  reviews Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Partner {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id])
  businessName String
  name String
  status PartnerStatus @default(DRAFT)
  online Boolean @default(false)
  dispatchEnabled Boolean @default(false)
  serviceRadiusKm Int @default(10)
  slug String? @unique
  claimStatus PartnerClaimStatus @default(UNCLAIMED)
  storefrontStatus StorefrontStatus @default(PUBLISHED)
  claimedAt DateTime?
  ratingAvg Decimal @default(0) @db.Decimal(3, 2)
  ratingCount Int @default(0)
  storefront PartnerStorefront?
  media PartnerMedia[]
  promotions PartnerPromotion[]
  businessHours PartnerBusinessHour[]
  analyticsEvents PartnerAnalyticsEvent[]
  rankingSnapshots PartnerRankingSnapshot[]
  claims PartnerClaim[]
  slugRedirects PartnerSlugRedirect[]
  services PartnerService[]
  areas PartnerArea[]
  availability PartnerAvailability[]
  orders Order[]
  applications PartnerApplication[]
  wallet PartnerWallet?
  payouts Payout[]
  dispatches DispatchAttempt[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, online])
}
model PartnerStorefront {
  id String @id @default(cuid())
  partnerId String @unique
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  displayName String?
  tagline String?
  description String?
  whatsapp String?
  publicAddress String?
  estimatedResponseMinutes Int?
  facilities Json?
  draftData Json?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PartnerMedia {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  kind PartnerMediaKind
  url String
  storageKey String
  mimeType String
  sizeBytes Int
  width Int?
  height Int?
  sortOrder Int @default(0)
  hidden Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([partnerId, kind, hidden, sortOrder])
}
model PartnerPromotion {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  title String
  description String?
  startsAt DateTime?
  endsAt DateTime?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([partnerId, active])
}
model PartnerBusinessHour {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  openMinute Int?
  closeMinute Int?
  closed Boolean @default(false)
  @@unique([partnerId, dayOfWeek])
}
model PartnerAnalyticsEvent {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  type String
  serviceId String?
  orderId String?
  sessionHash String?
  valueInt Int?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([partnerId, type, createdAt])
}
model PartnerRankingSnapshot {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  categoryId String
  areaId String
  score Decimal @db.Decimal(8, 5)
  rank Int?
  eligible Boolean @default(false)
  metrics Json
  calculatedAt DateTime @default(now())
  @@unique([partnerId, categoryId, areaId])
  @@index([categoryId, areaId, eligible, rank])
}
model PartnerClaim {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  phone String
  status PartnerClaimInvitationStatus @default(ACTIVE)
  expiresAt DateTime
  consumedAt DateTime?
  createdByUserId String
  createdAt DateTime @default(now())
  @@index([partnerId, status, expiresAt])
}
model PartnerSlugRedirect {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  oldSlug String @unique
  createdAt DateTime @default(now())
}

model PartnerApplication {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  status PartnerStatus @default(SUBMITTED)
  data Json
  documents Json?
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  rejectionReason String?
}
model PartnerService {
  partnerId String
  serviceId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  active Boolean @default(true)
  customPrice Int?
  @@id([partnerId, serviceId])
}
model PartnerArea {
  partnerId String
  areaId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  @@id([partnerId, areaId])
}
model PartnerAvailability {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startMinute Int
  endMinute Int
  active Boolean @default(true)
  @@index([partnerId, dayOfWeek])
}
model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  icon String?
  description String?
  imageUrl String?
  seoTitle String?
  seoDescription String?
  archivedAt DateTime?
  active Boolean @default(true)
  sortOrder Int @default(0)
  services Service[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Service {
  id String @id @default(cuid())
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  name String
  slug String @unique
  description String?
  fullDescription String?
  imageUrl String?
  seoTitle String?
  seoDescription String?
  popular Boolean @default(false)
  pricingType String @default("FIXED")
  unit String?
  commissionBps Int?
  sortOrder Int @default(0)
  archivedAt DateTime?
  basePrice Int
  minimumCharge Int @default(0)
  estimatedMinutes Int @default(60)
  active Boolean @default(true)
  featured Boolean @default(false)
  variants ServiceVariant[]
  addons ServiceAddon[]
  partners PartnerService[]
  orderItems OrderItem[]
  promotions PromotionService[]
  serviceAreas ServiceArea[]
  media ServiceMedia[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([categoryId, active])
}
model ServiceMedia {
  id String @id @default(cuid())
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url String
  storageKey String?
  mimeType String?
  sizeBytes Int?
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  @@index([serviceId, sortOrder])
}

model ServiceVariant {
  id String @id @default(cuid())
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name String
  priceDelta Int @default(0)
  active Boolean @default(true)
  sortOrder Int @default(0)
  estimatedMinutes Int?
}
model ServiceAddon {
  id String @id @default(cuid())
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name String
  price Int
  active Boolean @default(true)
  sortOrder Int @default(0)
}
model Area {
  id String @id @default(cuid())
  name String
  slug String @unique
  city String @default("Batam")
  active Boolean @default(true)
  district String?
  code String?
  content String?
  surcharge Int @default(0)
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  addresses Address[]
  partnerAreas PartnerArea[]
  orders Order[]
  promotions PromotionArea[]
  serviceAreas ServiceArea[]
  @@index([active, name])
}
model ServiceArea {
  serviceId String
  areaId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  active Boolean @default(true)
  @@id([serviceId, areaId])
  @@index([areaId, active])
}

model Address {
  id String @id @default(cuid())
  customerId String?
  customer CustomerProfile? @relation(fields: [customerId], references: [id])
  label String?
  recipientName String
  phone String
  line1 String
  line2 String?
  areaId String
  area Area @relation(fields: [areaId], references: [id])
  postalCode String?
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  createdAt DateTime @default(now())
}
model Order {
  id String @id @default(cuid())
  publicId String @unique
  customerId String
  customer CustomerProfile @relation(fields: [customerId], references: [id])
  partnerId String?
  partner Partner? @relation(fields: [partnerId], references: [id])
  areaId String
  area Area @relation(fields: [areaId], references: [id])
  status OrderStatus @default(NEW)
  source String @default("website")
  scheduledAt DateTime
  addressSnapshot Json
  customerNote String?
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  locationNote String?
  paymentMethod String @default("CASH")
  subtotal Int
  discount Int @default(0)
  paymentFee Int @default(0)
  areaSurcharge Int @default(0)
  total Int
  commission Int @default(0)
  partnerEarning Int @default(0)
  currency String @default("IDR")
  items OrderItem[]
  history OrderStatusHistory[]
  dispatches DispatchAttempt[]
  payment Payment?
  ledgerEntries LedgerEntry[]
  review Review?
  dispute Dispute?
  thread ChatThread?
  notes AdminNote[]
  attachments OrderAttachment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([partnerId, status])
  @@index([customerId, createdAt])
}
model OrderAttachment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  group String
  url String
  storageKey String?
  mimeType String
  sizeBytes Int
  originalName String
  uploadedByUserId String?
  createdAt DateTime @default(now())
  @@index([orderId, group, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String
  service Service @relation(fields: [serviceId], references: [id])
  name String
  quantity Int
  unitPrice Int
  variantSnapshot Json?
  addonsSnapshot Json?
  lineTotal Int
}
model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorRole String
  previousStatus OrderStatus?
  newStatus OrderStatus
  reason String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}
model DispatchAttempt {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  status DispatchStatus @default(OFFERED)
  offeredAt DateTime @default(now())
  expiresAt DateTime
  respondedAt DateTime?
  @@unique([orderId, partnerId, offeredAt])
  @@index([partnerId, status, expiresAt])
}
model Payment {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  provider String
  status PaymentStatus @default(PENDING)
  amount Int
  externalId String? @unique
  method String
  idempotencyKey String @unique
  events PaymentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentEvent {
  id String @id @default(cuid())
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerEventId String @unique
  type String
  payload Json
  verified Boolean
  createdAt DateTime @default(now())
}
model LedgerAccount {
  id String @id @default(cuid())
  code String @unique
  name String
  ownerType String
  ownerId String?
  entries LedgerEntry[]
  createdAt DateTime @default(now())
  @@index([ownerType, ownerId])
}
model LedgerEntry {
  id String @id @default(cuid())
  transactionId String
  accountId String
  account LedgerAccount @relation(fields: [accountId], references: [id])
  orderId String?
  order Order? @relation(fields: [orderId], references: [id])
  direction LedgerDirection
  amount Int
  memo String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([transactionId])
  @@index([accountId, createdAt])
  @@index([orderId])
}
model PartnerWallet {
  id String @id @default(cuid())
  partnerId String @unique
  partner Partner @relation(fields: [partnerId], references: [id])
  pending Int @default(0)
  available Int @default(0)
  onHold Int @default(0)
  updatedAt DateTime @updatedAt
}
model Payout {
  id String @id @default(cuid())
  partnerId String
  partner Partner @relation(fields: [partnerId], references: [id])
  amount Int
  status PayoutStatus @default(REQUESTED)
  destinationSnapshot Json
  idempotencyKey String @unique
  reference String?
  reviewedBy String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([partnerId, status])
}
model Promotion {
  id String @id @default(cuid())
  code String @unique
  name String
  description String?
  type String
  value Int
  maxDiscount Int?
  minimumOrder Int @default(0)
  firstOrderOnly Boolean @default(false)
  startsAt DateTime
  endsAt DateTime
  quota Int?
  perUserLimit Int @default(1)
  active Boolean @default(true)
  services PromotionService[]
  areas PromotionArea[]
  redemptions PromotionRedemption[]
}
model PromotionService {
  promotionId String
  serviceId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([promotionId, serviceId])
}
model PromotionArea {
  promotionId String
  areaId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  area Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  @@id([promotionId, areaId])
}
model PromotionRedemption {
  id String @id @default(cuid())
  promotionId String
  promotion Promotion @relation(fields: [promotionId], references: [id])
  customerId String
  orderId String
  amount Int
  createdAt DateTime @default(now())
  @@unique([promotionId, orderId])
  @@index([promotionId, customerId])
}
model Review {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  customerId String
  customer CustomerProfile @relation(fields: [customerId], references: [id])
  rating Int
  comment String?
  published Boolean @default(true)
  flagged Boolean @default(false)
  moderationReason String?
  createdAt DateTime @default(now())
}
model Dispute {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id])
  status DisputeStatus @default(OPEN)
  reason String
  description String
  resolution String?
  adminNotes String?
  evidence DisputeEvidence[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DisputeEvidence {
  id String @id @default(cuid())
  disputeId String
  dispute Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  attachmentId String
  description String?
  createdAt DateTime @default(now())
}
model ChatThread {
  id String @id @default(cuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  createdAt DateTime @default(now())
}
model ChatMessage {
  id String @id @default(cuid())
  threadId String
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUserId String?
  role MessageRole
  body String?
  attachments Attachment[]
  createdAt DateTime @default(now())
  @@index([threadId, createdAt])
}
model Attachment {
  id String @id @default(cuid())
  messageId String?
  message ChatMessage? @relation(fields: [messageId], references: [id])
  kind AttachmentKind
  storageKey String
  mimeType String
  sizeBytes Int
  originalName String
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(cuid())
  userId String
  type String
  channel String
  payload Json
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model AdminNote {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorUserId String
  body String
  createdAt DateTime @default(now())
}
model CMSPage {
  id String @id @default(cuid())
  key String @unique
  title String
  content Json
  status PublishStatus @default(DRAFT)
  seoTitle String?
  seoDescription String?
  updatedAt DateTime @updatedAt
}
model Banner {
  id String @id @default(cuid())
  title String
  subtitle String?
  imageUrl String?
  href String?
  status PublishStatus @default(DRAFT)
  sortOrder Int @default(0)
  startsAt DateTime?
  endsAt DateTime?
}
model FAQ {
  id String @id @default(cuid())
  question String
  answer String
  status PublishStatus @default(DRAFT)
  sortOrder Int @default(0)
}
model AuditLog {
  id String @id @default(cuid())
  actorUserId String?
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id])
  action String
  entityType String
  entityId String?
  requestId String?
  ipHash String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([createdAt])
}
model OTPChallenge {
  id String @id @default(cuid())
  phone String
  codeHash String
  attempts Int @default(0)
  maxAttempts Int @default(5)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
}
model IdempotencyKey {
  id String @id @default(cuid())
  scope String
  key String
  response Json?
  statusCode Int?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([scope, key])
}
model Setting {
  key String @id
  value Json
  updatedAt DateTime @updatedAt
}
