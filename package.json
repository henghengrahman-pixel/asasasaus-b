{
  "name": "jasabatam",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "start:railway": "npm run db:migrate:railway && npm run db:seed && npm start",
    "db:migrate:railway": "node scripts/railway-migrate.mjs",
    "audit:static": "node scripts/audit-project.mjs && node scripts/audit-css.mjs",
    "audit:css": "node scripts/audit-css.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "lucide-react": "0.544.0",
    "next": "15.5.9",
    "otplib": "12.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11",
    "qrcode": "1.5.4",
    "@aws-sdk/client-s3": "3.883.0"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.9",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "@tailwindcss/postcss": "4.1.13",
    "@eslint/eslintrc": "3.3.1",
    "@types/qrcode": "1.5.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
